<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer><rewrite><rules><clear/><rule name="ActivityTAB HTTPS" stopProcessing="true"><match url="(.*)"/><conditions><add input="{HTTPS}" pattern="off"/></conditions><action type="Redirect" url="https://mis-sweetdreams.in/ActivityTAB/{R:1}" redirectType="Permanent"/></rule><rule name="ActivityTAB Loopback" stopProcessing="true"><match url="(.*)"/><action type="Rewrite" url="http://127.0.0.1:3187/ActivityTAB/{R:1}"/></rule></rules></rewrite><security><requestFiltering><requestLimits maxAllowedContentLength="23068672"/></requestFiltering></security><httpErrors existingResponse="PassThrough"/><directoryBrowse enabled="false"/></system.webServer></configuration>
